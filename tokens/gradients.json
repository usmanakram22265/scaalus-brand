{
  "$description": "Scaalus gradients v3.1 — fixed stops. Grounds fill the frame, masses are the one shape per post, highlights colour 1–3 headline words. Stops reference tokens/palette.json. Angles are CSS degrees (90 = to right, 180 = to bottom).",
  "gradient": {
    "accent-bar": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.logo-blue}",
          "position": 0
        },
        {
          "color": "{color.logo-indigo}",
          "position": 0.5
        },
        {
          "color": "{color.logo-violet}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Accent bar",
          "group": "brand",
          "angle": 90,
          "use": "The logo gradient as a short bar on every post. The only place all three logo colours appear together outside the logo."
        }
      }
    },
    "logo": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.logo-blue}",
          "position": 0
        },
        {
          "color": "{color.logo-indigo}",
          "position": 0.65
        },
        {
          "color": "{color.logo-violet}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Logo gradient",
          "group": "brand",
          "angle": 135,
          "use": "Daylight's circle. Blue-weighted so violet stays a small accent."
        }
      }
    },
    "ground-electric": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.night-blue}",
          "position": 0
        },
        {
          "color": "{color.abyss}",
          "position": 0.72
        },
        {
          "color": "{color.abyss}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Electric ground",
          "group": "ground",
          "angle": 165,
          "mood": "electric"
        }
      }
    },
    "ground-midnight": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.navy}",
          "position": 0
        },
        {
          "color": "{color.abyss}",
          "position": 0.75
        },
        {
          "color": "{color.abyss}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Midnight ground",
          "group": "ground",
          "angle": 170,
          "mood": "midnight"
        }
      }
    },
    "ground-cobalt": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.deep-royal}",
          "position": 0
        },
        {
          "color": "{color.royal-blue}",
          "position": 0.55
        },
        {
          "color": "{color.cobalt}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Cobalt ground",
          "group": "ground",
          "angle": 150,
          "mood": "cobalt",
          "use": "From v2: deep royal into cobalt."
        }
      }
    },
    "ground-daylight": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.white}",
          "position": 0
        },
        {
          "color": "{color.mist}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Daylight ground",
          "group": "ground",
          "angle": 180,
          "mood": "daylight"
        }
      }
    },
    "ground-sky": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.mist}",
          "position": 0
        },
        {
          "color": "{color.cloud}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Sky ground",
          "group": "ground",
          "angle": 165,
          "mood": "sky"
