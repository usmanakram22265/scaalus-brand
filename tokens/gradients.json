        {
          "color": "{color.navy-royal}",
          "position": 0.5
        },
        {
          "color": "{color.royal}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Royal aurora",
          "group": "mass",
          "angle": 135,
          "theme": "dark",
          "use": "Navy → Navy Royal → Scaalus Blue. Electric's calmer alternative colour mass."
        }
      }
    },
    "mass-sweep": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.royal}",
          "position": 0.2,
          "alpha": 0
        },
        {
          "color": "{color.royal}",
          "position": 0.5,
          "alpha": 0.85
        },
        {
          "color": "{color.logo-blue}",
          "position": 0.6,
          "alpha": 0.9
        },
        {
          "color": "{color.royal}",
          "position": 0.7,
          "alpha": 0.4
        },
        {
          "color": "{color.royal}",
          "position": 0.9,
          "alpha": 0
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Rising sweep",
          "group": "mass",
          "angle": 30,
          "theme": "dark",
          "use": "Signature dark gradient: a soft band of blue light rising from bottom-left to top-right (the logo's growth direction), laid over the Midnight ground."
        }
      }
    },
    "mass-glass": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.white}",
          "position": 0,
          "alpha": 0.3
        },
        {
          "color": "{color.white}",
          "position": 1,
          "alpha": 0.05
