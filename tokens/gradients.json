        {
          "color": "{color.mist}",
          "position": 0
        },
        {
          "color": "{color.white}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Frost ground",
          "group": "ground",
          "angle": 180,
          "mood": "frost"
        }
      }
