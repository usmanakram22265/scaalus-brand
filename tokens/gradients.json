    "mass-electric-aurora": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.night-blue}",
          "position": 0
        },
        {
          "color": "{color.royal-blue}",
          "position": 0.45
        },
        {
          "color": "{color.electric}",
          "position": 1
        }
      ],
      "$extensions": {
        "scaalus": {
          "name": "Electric aurora",
          "group": "mass",
          "angle": 135,
          "theme": "dark",
          "use": "From v2: night blue → royal blue → electric. Electric's colour mass."
